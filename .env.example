# 模板：复制为 .env 并填入真实值（.env 已被 git 忽略，不会提交）

# DeepSeek 语音识别（默认 asr.provider=deepseek：同步上传整段音频，只返回文本，无字级时间戳）
DEEPSEEK_API_KEY=

# 火山引擎（新版控制台：控制台 > API Key 管理 → 生成 API Key）
# 用于：TTS 声音克隆与合成；把 config.yaml 的 asr.provider 改回 volc 时 ASR 也用它
VOLC_API_KEY=

# 文件中转网盘（pan.ezv.cc）：仅 volc ASR 标准版提交需要公开 URL，本地音频先传到这里中转
PAN_API_KEY=
